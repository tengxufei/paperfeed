# Generated by every run — churns constantly, not worth versioning.
state/
digests/
paperfeed.log
library.db

# Transient / crash leftovers
*.tmp
*.corrupt

.DS_Store
__pycache__/
*.pyc

# Retrospective search cache - working files, safe to delete
cache/

# Your own settings. Start from paperfeed/config.example.json.
paperfeed/config.json
paperfeed/config.json.bak
